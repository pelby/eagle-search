{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eagle Search blind evaluation label batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_version", "batch_id", "provider", "model", "caption_blind", "guide_hash", "labels"],
  "properties": {
    "batch_version": {"type": "integer", "const": 1},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 100},
    "model": {"type": "string", "minLength": 1, "maxLength": 100},
    "caption_blind": {"type": "boolean", "const": true},
    "guide_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "labels": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_alias_groups", "image_type_aliases", "ocr_truth", "queries", "critical_absent_terms", "uncertainty"],
        "properties": {
          "concept_alias_groups": {
            "type": "array",
            "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "image_type_aliases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ocr_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["high", "medium"],
            "properties": {
              "high": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "medium": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "queries": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
          "critical_absent_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "uncertainty": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
