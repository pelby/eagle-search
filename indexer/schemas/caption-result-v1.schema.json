{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eagle-search.local/schemas/caption-result-v1.schema.json",
  "title": "CaptionResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "image_type",
    "diagram_types",
    "subjects",
    "visual_style",
    "colours",
    "layout",
    "visible_text",
    "search_terms",
    "summary",
    "uncertainties"
  ],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "image_type": { "type": "string", "minLength": 1, "maxLength": 100 },
    "diagram_types": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "subjects": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "visual_style": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "colours": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "layout": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "visible_text": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "legibility"],
        "properties": {
          "text": { "type": "string", "maxLength": 1000 },
          "legibility": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "search_terms": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "uncertainties": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
